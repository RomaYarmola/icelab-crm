# CRM IceLab: змінні середовища.
#
# Локально: скопіюйте цей файл у .env.local і заповніть значення. .env.local не комітиться.
# Staging і production: значення задаються лише у Vercel (Settings, Environment Variables).
# Коментарі пишемо окремими рядками: у кінці рядка зі значенням вони можуть потрапити в значення.

# ===== B0: основа =====

# Яке це середовище: dev, staging або prod
APP_ENV=dev

# Рядок підключення до Postgres (Supabase: кнопка Connect, вкладка Direct, Session pooler).
# Для Vercel (staging, prod) пізніше використаємо Transaction pooler (порт 6543).
# Спецсимволи в паролі мають бути закодовані (percent-encoding).
DATABASE_URL=

# ===== B2: Supabase Auth і Realtime =====

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Секретний ключ лише для сервера, ніколи не потрапляє в браузер
SUPABASE_SECRET_KEY=

# ===== Наступні блоки (поки не використовуються) =====

# B10, B13: секрет для cron-ендпоінтів
# CRON_SECRET=
# B10: ключ API Нової Пошти
# NOVA_POSHTA_API_KEY=
# B11: Telegram-бот, секрет вебхука, секрет сайту, ключ Claude
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# LEAD_SITE_SECRET=
# ANTHROPIC_API_KEY=
# B13: monobank
# MONOBANK_TOKEN=
# B15: розпізнавання мовлення
# STT_API_KEY=
